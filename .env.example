# Copy this file to .env at the repository root, fill only the values you need,
# then run: node scripts/sync-local-secrets.mjs

# Publishable client configuration
# These values are allowed in iOS and Vite bundles. Leave the Supabase pair empty
# to let the sync script discover a running local Supabase stack.
SUPABASE_URL=
SUPABASE_ANON_KEY=
INVITE_LINK_BASE_URL=

# Server-only provider and hosted-test configuration
# Never copy these values into AIKanji/Secrets.xcconfig, web/.env.local, or a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
HOTPEPPER_API_KEY=
TABELOG_ENRICHMENT_ENABLED=false
AIKANJI_TEST_PASSWORD=

# xcodebuild forwards TEST_RUNNER_* variables to the test process without the prefix.
# Shell-source .env before running hosted iOS domain tests so these references expand.
TEST_RUNNER_SUPABASE_URL="${SUPABASE_URL}"
TEST_RUNNER_SUPABASE_ANON_KEY="${SUPABASE_ANON_KEY}"
TEST_RUNNER_SUPABASE_SERVICE_ROLE_KEY="${SUPABASE_SERVICE_ROLE_KEY}"
TEST_RUNNER_AIKANJI_TEST_PASSWORD="${AIKANJI_TEST_PASSWORD}"
