# Do not copy or maintain this file separately.
# From the repository root, copy .env.example to .env, fill the values there, and run:
#   node scripts/sync-local-secrets.mjs
# That command generates the gitignored web/.env.local; without it, Vite uses the mock fixture.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
