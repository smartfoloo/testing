# Copy to .env.local and fill both values to run against a real Supabase project.
# Leave them unset (or delete .env.local) to run on the in-browser mock fixture.
#
# The scheme is optional; https:// is prepended when missing.
VITE_SUPABASE_URL=your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
