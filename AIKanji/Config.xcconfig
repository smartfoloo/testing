// Compile-safe placeholders only. For local or hosted development, copy the repository-root
// .env.example to .env and run `node scripts/sync-local-secrets.mjs` from the repository root.
// The generated, gitignored Secrets.xcconfig overrides these values.
SUPABASE_URL = your-project.supabase.co
SUPABASE_ANON_KEY = your-publishable-anon-key

// Empty means QR codes and sharing fall back to the bare invite code. A configured HTTPS host
// also needs the Associated Domains entitlement and an apple-app-site-association file.
INVITE_LINK_BASE_URL =

#include? "Secrets.xcconfig"
