// Supabase project credentials. `//` must be escaped in xcconfig URLs, hence
// SUPABASE_URL is written without the scheme; SupabaseConfig prepends https://.
// Override locally by creating Secrets.xcconfig (gitignored) with the real values.
SUPABASE_URL = your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// Host the invite links are built against, e.g. INVITE_LINK_BASE_URL = matomeshi.example.com
// (no scheme, for the same reason as SUPABASE_URL — InviteLink prepends https://).
// Deliberately EMPTY here rather than pointing at a domain nobody owns: with no value the
// QR code and the share sheet fall back to the bare 6-character invite code, which is what
// the app did before invite links existed. Set it in Secrets.xcconfig — an https invite link
// also needs the Associated Domains entitlement plus an apple-app-site-association file on
// that host before iOS will open it in the app.
INVITE_LINK_BASE_URL =

#include? "Secrets.xcconfig"
